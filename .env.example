# MiniClaw Configuration
# Copy this file to .env and modify values

# Agent
AGENT_NAME=MiniClaw
AGENT_VERSION=0.1.0

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/miniclaw
DATABASE_ECHO=false

# Model Provider (ollama, openai, anthropic, openai_compatible)
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Compatible (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-...

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Feature Flags
ENABLE_BROWSER=true
ENABLE_GITHUB=true
ENABLE_REMOTE_ACCESS=false
ENABLE_SCHEDULER=true
ENABLE_NOTIFICATIONS=true

# GitHub Integration
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=...

# Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=...
WEB_PUSH_VAPID_PRIVATE_KEY=...
WEB_PUSH_VAPID_CLAIMS_SUB=mailto:admin@localhost

# Telegram (optional)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Discord (optional)
DISCORD_BOT_TOKEN=...
DISCORD_CHANNEL_ID=...

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=...
SMTP_PASSWORD=...
SMTP_FROM_EMAIL=...

# Remote Access (optional)
TAILSCALE_AUTH_KEY=...
CLOUDFLARE_TUNNEL_TOKEN=...

# Approval & Limits
APPROVAL_TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=100
MAX_COMMAND_OUTPUT_CHARS=10000

# Directories
DATA_DIR=./data
LOGS_DIR=./logs
PLUGINS_DIR=./plugins
VECTOR_DB_PATH=./data/vector_db